# DeepVisionAttend AI Service - example configuration.
# Copy to `.env` and edit. Every value below is optional: the defaults in
# config.py are used when a variable is absent.
#
#   cp .env.example .env

# --- Service ----------------------------------------------------------------
DVA_HOST=0.0.0.0
DVA_PORT=8000
DVA_LOG_LEVEL=INFO
DVA_RELOAD=false

# Origins allowed to call this service (the React frontend, the Node backend).
DVA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Model ------------------------------------------------------------------
# buffalo_l = SCRFD-10G detector + ArcFace R50 (recommended).
# buffalo_s is a smaller/faster pack for low-powered machines.
DVA_MODEL_PACK=buffalo_l

# -1 runs on the CPU. Set to 0 to use the first CUDA GPU
# (also requires onnxruntime-gpu instead of onnxruntime).
DVA_CTX_ID=-1

# Detector input resolution. 320,320 is roughly 2x faster than 640,640 but
# misses smaller/more distant faces.
DVA_DET_SIZE=640,640

# --- Thresholds -------------------------------------------------------------
# Minimum detector confidence for a face to be considered at all.
DVA_DET_SCORE_THRESHOLD=0.5

# Minimum cosine similarity to accept an identity. Raise it to cut false
# positives, lower it to cut false negatives. Must be <= attendance_threshold.
DVA_RECOGNITION_THRESHOLD=0.45

# Attendance is only marked at or above this similarity. Kept deliberately
# stricter than recognition: a wrong name on the register is worse than a retry.
DVA_ATTENDANCE_THRESHOLD=0.55

# Faces whose shorter side is under this many pixels are ignored.
DVA_MIN_FACE_SIZE=50

# Laplacian-variance sharpness floor for enrolment images.
DVA_BLUR_THRESHOLD=45.0

# --- Registration -----------------------------------------------------------
DVA_REGISTRATION_CAPTURES=5
DVA_REGISTRATION_MIN_IMAGES=3
DVA_REGISTRATION_CAPTURE_INTERVAL=1.0
DVA_MAX_EMBEDDINGS_PER_STUDENT=20

# --- Attendance policy ------------------------------------------------------
DVA_DEFAULT_SESSION=general

# One record per student per session per day.
DVA_ONCE_PER_SESSION_PER_DAY=true

# Extra time-based guard for continuous camera feeds. 0 disables it.
DVA_DUPLICATE_COOLDOWN_MINUTES=0

# --- Camera -----------------------------------------------------------------
DVA_CAMERA_INDEX=0
DVA_CAMERA_WIDTH=1280
DVA_CAMERA_HEIGHT=720
DVA_RECOGNITION_FRAME_INTERVAL=3

# --- Limits -----------------------------------------------------------------
DVA_MAX_UPLOAD_BYTES=10485760

# ============================================================================
# AUTHENTICATION (accounts live in MongoDB)
# ============================================================================

# --- MongoDB ----------------------------------------------------------------
DVA_MONGODB_URI=mongodb://127.0.0.1:27017
DVA_MONGODB_DB=deepvisionattend

# --- JWT --------------------------------------------------------------------
# REQUIRED IN PRODUCTION. The built-in default is public — anyone who reads this
# repository could forge a login token with it. Generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
# DVA_JWT_SECRET=<paste the generated value here>

# How long a session lasts (minutes). 720 = 12 hours.
DVA_JWT_EXPIRE_MINUTES=720

# --- Access control ---------------------------------------------------------
# When false, every endpoint is open to anyone who can reach the port.
DVA_REQUIRE_AUTH=true

# The first account created becomes an admin; the rest are lecturers.
DVA_FIRST_USER_IS_ADMIN=true
DVA_PASSWORD_MIN_LENGTH=8

# --- Password reset ---------------------------------------------------------
DVA_RESET_TOKEN_EXPIRE_MINUTES=30

# DEVELOPMENT ONLY. When true the API returns the reset link in the response
# instead of emailing it — which means anyone who knows an address can take over
# that account. MUST be false in production.
DVA_EXPOSE_RESET_LINK=true

# Where reset links point (your React app).
DVA_FRONTEND_URL=http://localhost:5173
